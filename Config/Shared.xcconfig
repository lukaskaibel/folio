// Settings shared by every build. Personal settings (your signing team) go in Local.xcconfig,
// which is not checked in.

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

PRODUCT_BUNDLE_IDENTIFIER = com.lukaskbl.Notebook

// Without a team the Mac app is signed to run on this Mac only, and the iPhone and iPad app runs in the Simulator,
// which is all a local build needs. To run it on your own iPhone or iPad, set your team in Local.xcconfig.
DEVELOPMENT_TEAM =
CODE_SIGN_IDENTITY = -
CODE_SIGN_IDENTITY[sdk=iphoneos*] = Apple Development

// Debug and Release run without the sandbox, so tests can point the app at any folder. The App Store build is
// sandboxed and reaches folders through the bookmarks of the locations you add. It also has iCloud's key-value store,
// which takes the folders you hide to your other devices; the other builds keep them on this Mac.
NOTEBOOK_MAC_ENTITLEMENTS =
NOTEBOOK_MAC_ENTITLEMENTS[config=AppStore] = Config/Notebook-macOS.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = $(NOTEBOOK_MAC_ENTITLEMENTS)

#include? "Local.xcconfig"
